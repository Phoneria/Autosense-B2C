# Copy to .env.production, chmod 600, populate. Never commit real values.
# docker compose --env-file .env.production up --build -d
B2C_DOMAIN=b2c.example.com
# Gunicorn: B2C_WORKERS = sunucudaki vCPU sayısı (4 vCPU->4, 8 vCPU->8). Her worker ~300-500 MB RAM.
B2C_WORKERS=4
B2C_THREADS=4
# Analiz sonucu Redis cache süresi (sn); 0 = kapalı.
B2C_ANALYSIS_CACHE_TTL=3600
# Generate each with python -c "import secrets; print(secrets.token_urlsafe(48))"
B2C_SECRET_KEY=
B2C_DB_PASSWORD=
B2C_SMTP_HOST=
B2C_SMTP_PORT=587
B2C_SMTP_USER=
B2C_SMTP_PASSWORD=
B2C_SMTP_TLS=true
# Köşeli parantez shell yönlendirmesidir; değeri tırnak içinde bırakın.
B2C_FROM_EMAIL="Autosense <noreply@example.com>"
