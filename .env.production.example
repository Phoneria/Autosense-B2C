# Copy to .env.production, chmod 600, populate. Never commit real values.
# docker compose --env-file .env.production up --build -d
B2C_DOMAIN=b2c.example.com
# Generate each with python -c "import secrets; print(secrets.token_urlsafe(48))"
B2C_SECRET_KEY=
B2C_DB_PASSWORD=
B2C_SMTP_HOST=
B2C_SMTP_PORT=587
B2C_SMTP_USER=
B2C_SMTP_PASSWORD=
B2C_SMTP_TLS=true
B2C_FROM_EMAIL=Autosense <noreply@example.com>
