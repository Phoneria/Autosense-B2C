# Local development only. Copy to .env; ./dev.sh loads this file.
B2C_DEBUG=true
B2C_FRONTEND_URL=http://localhost:5176
# Ports (defaults 8010 / 5176); change both plus B2C_FRONTEND_URL together:
# B2C_BACKEND_PORT=8010
# B2C_FRONTEND_PORT=5176
B2C_ALLOWED_HOSTS=localhost,127.0.0.1
B2C_EMAIL_BACKEND=accounts.mail.PrivateFileBackend
# Optional absolute paths (defaults are inside this project):
# B2C_ACCOUNT_DB=/absolute/path/accounts.sqlite3
# B2C_REFERENCE_DB=/absolute/path/listings.sqlite3
# B2C_BASELINE_DB=/absolute/path/paket_fiyatlari.db
# B2C_GALLERY_DB=/absolute/path/galeri.db
# B2C_MAIL_DIR=/absolute/path/private-mail
# Optional shared cache; required in production:
# B2C_REDIS_URL=redis://localhost:6379/0
